     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/visits": {
   "get": {
    "summary": "Visitas (coadd por visita) + escalera de λ",
    "operationId": "visits_api_visits_get",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Preset: wise0855, barnard, epsindib, rwaur, rdra",
       "title": "Name"
      },
      "description": "Preset: wise0855, barnard, epsindib, rwaur, rdra"
     },
     {
      "name": "ra",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Ra"
      }
     },
     {
      "name": "dec",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Dec"
      }
     },
     {
      "name": "epoch",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "description": "Época (año decimal) de ra/dec",
       "default": 2016.0,
       "title": "Epoch"
      },
      "description": "Época (año decimal) de ra/dec"
     },
     {
      "name": "pmra",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "description": "pm en RA·cos δ, arcsec/año",
       "default": 0.0,
       "title": "Pmra"
      },
      "description": "pm en RA·cos δ, arcsec/año"
     },
     {
      "name": "pmdec",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "description": "pm en Dec, arcsec/año",
       "default": 0.0,
       "title": "Pmdec"
      },
      "description": "pm en Dec, arcsec/año"
     },
     {
      "name": "fov",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 0.5,
       "minimum": 0.03,
       "description": "lado del campo en grados (0.1° = 59 px)",
       "default": 0.1,
       "title": "Fov"
      },
      "description": "lado del campo en grados (0.1° = 59 px)"
     },
     {
      "name": "det",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "Detectores: '5', '5,6' o 'all'",
       "default": "all",
       "title": "Det"
      },
      "description": "Detectores: '5', '5,6' o 'all'"
     },
     {
      "name": "release",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "qr2,qr3,dr1 (vacío = todos)",
       "title": "Release"
      },
      "description": "qr2,qr3,dr1 (vacío = todos)"
     },
     {
      "name": "max_per_visit",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 40,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "description": "tope de exposiciones por visita y detector",
       "default": 8,
       "title": "Max Per Visit"
      },
      "description": "tope de exposiciones por visita y detector"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/VisitsResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
